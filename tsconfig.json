{
  "compilerOptions": {
    "types": ["mocha", "chai"],
    "typeRoots": ["./node_modules/@types"],
    "lib": ["es2015"],
    "module": "commonjs",
    "target": "es6",
    "resolveJsonModule": true,      // Enable JSON imports
    "esModuleInterop": true,        // Ensure proper compatibility with ES modules
  }
}
